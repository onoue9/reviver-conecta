rules_version = '2';

// Deny by default: anything not explicitly allowed below is rejected.
//
// Actors:
// - Visitors read the public catalogue (cursos, turmas).
// - Alunos sign in anonymously and can only create/read their own data.
// - Equipe: non-anonymous users whose uid has a doc in /usuariosEquipe.
//   That collection is managed outside the app (console / Admin SDK).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isEquipe() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/usuariosEquipe/$(request.auth.uid));
    }

    function turmaPath(turmaId) {
      return /databases/$(database)/documents/turmas/$(turmaId);
    }

    function inscricaoPath(turmaId, alunoId) {
      return /databases/$(database)/documents/inscricoes/$(turmaId + '_' + alunoId);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Catch-all deny (explicit, for readability).
    match /{document=**} {
      allow read, write: if false;
    }

    match /usuariosEquipe/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isEquipe();
      allow write: if false;
    }

    match /cursos/{cursoId} {
      allow read: if true;
      allow write: if isEquipe();
    }

    match /turmas/{turmaId} {
      allow read: if true;
      allow create, delete: if isEquipe();
      allow update: if isEquipe() || reservaDeVaga(turmaId);

      // An aluno may only take one seat, in the same batch that creates
      // their confirmed inscrição for this turma.
      function reservaDeVaga(turmaId) {
        return signedIn()
          && resource.data.status == 'aberta'
          && changedOnly(['vagasOcupadas'])
          && request.resource.data.vagasOcupadas == resource.data.vagasOcupadas + 1
          && request.resource.data.vagasOcupadas <= resource.data.vagasTotais
          && !exists(inscricaoPath(turmaId, request.auth.uid))
          && getAfter(inscricaoPath(turmaId, request.auth.uid)).data.status == 'confirmada';
      }
    }

    match /alunos/{alunoId} {
      allow get: if isEquipe() || (signedIn() && request.auth.uid == alunoId);
      allow list: if isEquipe();
      allow create, update: if isEquipe() || (signedIn() && request.auth.uid == alunoId && alunoValido());
      allow delete: if isEquipe();

      function alunoValido() {
        let d = request.resource.data;
        return d.keys().hasAll(['nome', 'dataNascimento', 'telefone', 'bairro', 'consentimentoLgpd'])
          && d.keys().hasOnly(['nome', 'dataNascimento', 'telefone', 'email', 'bairro', 'consentimentoLgpd'])
          && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 120
          && d.dataNascimento is string && d.dataNascimento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.telefone is string && d.telefone.matches('^[0-9]{10,13}$')
          && d.bairro is string && d.bairro.size() > 0 && d.bairro.size() <= 80
          && (!('email' in d) || (d.email is string && d.email.size() <= 120))
          && d.consentimentoLgpd == true;
      }
    }

    match /inscricoes/{inscricaoId} {
      // `get` is checked against the id so an aluno can probe their own
      // (possibly missing) inscrição inside the sign-up transaction.
      allow get: if isEquipe()
        || (signedIn() && inscricaoId.matches('.+_' + request.auth.uid));
      allow list: if isEquipe();
      allow update, delete: if isEquipe();
      allow create: if isEquipe() || inscricaoPropria(inscricaoId);

      function inscricaoPropria(inscricaoId) {
        let d = request.resource.data;
        let turmaAntes = get(turmaPath(d.turmaId)).data;
        let turmaDepois = getAfter(turmaPath(d.turmaId)).data;
        return signedIn()
          && d.keys().hasOnly(['turmaId', 'cursoId', 'alunoId', 'nomeAluno', 'status', 'criadaEm'])
          && d.alunoId == request.auth.uid
          && inscricaoId == d.turmaId + '_' + request.auth.uid
          && d.cursoId == turmaAntes.cursoId
          && d.nomeAluno is string && d.nomeAluno.size() <= 120
          && d.criadaEm == request.time
          && turmaAntes.status == 'aberta'
          && existsAfter(/databases/$(database)/documents/alunos/$(request.auth.uid))
          && (
            (d.status == 'confirmada'
              && turmaDepois.vagasOcupadas == turmaAntes.vagasOcupadas + 1)
            || (d.status == 'lista_espera'
              && turmaAntes.vagasOcupadas >= turmaAntes.vagasTotais
              && turmaDepois.vagasOcupadas == turmaAntes.vagasOcupadas)
          );
      }
    }
  }
}
